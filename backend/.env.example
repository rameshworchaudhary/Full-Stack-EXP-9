# Spring Boot Backend Environment Variables
PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cidb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Secret token used by GitHub Actions / CI runner to push real test results
CI_INGESTION_TOKEN=your-ci-secret-token-here

# Allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
